PROJECT_NAME="Festa do Servidor"

# Banco de Dados Local no Docker (Alta Performance - Latência < 1ms)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/festa_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=festa_db
DB_ECHO=false

# Segurança (JWT)
SECRET_KEY="altere-esta-chave-secreta-em-producao-para-uma-chave-forte"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Servidor
WORKERS_COUNT=4

# Amazon SES / SMTP
SMTP_HOST=seu-smtp-host.amazonaws.com
SMTP_PORT=587
SMTP_USER=seu-smtp-usuario
SMTP_PASSWORD=sua-smtp-senha
SMTP_FROM=ingresso@seudominio.com.br
SMTP_FROM_NAME="Festa do Servidor"
